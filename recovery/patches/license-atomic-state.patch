+  // Recovery: commit related license records in one IndexedDB transaction so
+  // the saved license and its server-issued device token can never split.
+  async setMany(entries){
+    const db=await this.open();if(!db)throw new Error('idb-unavailable');
+    return new Promise((res,rej)=>{
+      try{
+        const tx=db.transaction('kv','readwrite');
+        const st=tx.objectStore('kv');
+        tx.oncomplete=()=>res();
+        tx.onerror=()=>rej(tx.error||new Error('idb-transaction-failed'));
+        tx.onabort=()=>rej(tx.error||new Error('idb-transaction-aborted'));
+        for(const [key,val] of entries)st.put(val,key);
+      }catch(e){rej(e);}
+    });
+  },
