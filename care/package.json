{
  "name": "realmwright-care",
  "version": "0.1.0",
  "private": true,
  "description": "RealmWright Customer Care — public board + intake wizard + owner desk. Cloudflare Worker, D1, Workers AI. No framework, no build step.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to=.wrangler/state",
    "migrate:local": "wrangler d1 migrations apply realmwright-care --local",
    "migrate:remote": "wrangler d1 migrations apply realmwright-care --remote",
    "seed:local": "node scripts/seed.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  }
}
