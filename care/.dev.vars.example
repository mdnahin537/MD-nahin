# Copy this file to .dev.vars for local development (that file is
# gitignored — never commit real secrets to either file; this one only
# ever holds dummy placeholders.
#
# In production these are set with wrangler secret put <NAME> — see
# care/README.md for the full click-by-click list.

SESSION_SECRET=dummy-local-session-secret-replace-with-a-long-random-value
OWNER_SETUP_TOKEN=dummy-local-owner-setup-token

# Optional — only needed if you want to exercise the OpenRouter fallback
# path for the Owner Desk AI digest (used when Workers AI is unavailable).
OPENROUTER_KEY=

# Optional — the public contact address the /privacy page links to. Not a
# secret (it's meant to be published). In production set it in wrangler.toml
# [vars] instead; this local override lets you see the working mailto during
# wrangler dev. Leave empty to preview the set-at-deploy placeholder.
CONTACT_EMAIL=

# Local-only. Marks cookies non-Secure during wrangler dev.
# wrangler.toml sets ENVIRONMENT=production for the real deploy.
ENVIRONMENT=development
