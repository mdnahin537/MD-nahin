{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "model": "opusplan",
  "effortLevel": "xhigh",
  "alwaysThinkingEnabled": true,
  "disableAgentView": false,
  "autoScrollEnabled": true,
  "showTurnDuration": true,
  "autoMemoryEnabled": true,

  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },

  "permissions": {
    "allow": [
      "Skill",
      "Agent(*)",
      "Task(*)",
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "WebFetch",
      "WebSearch",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push origin*)",
      "Bash(git push -u origin*)",
      "Bash(git push --set-upstream origin*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Bash(git tag*)",
      "Bash(git remote*)",
      "Bash(git restore*)",
      "Bash(git clone*)",
      "Bash(git config*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(echo*)",
      "Bash(sed*)",
      "Bash(awk*)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(wc*)",
      "Bash(tree*)",
      "Bash(diff*)",
      "Bash(mkdir*)",
      "Bash(touch*)",
      "Bash(cp*)",
      "Bash(mv*)",
      "Bash(ln*)",
      "Bash(chmod +x*)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npx*)",
      "Bash(node*)",
      "Bash(bun*)",
      "Bash(bunx*)",
      "Bash(yarn*)",
      "Bash(pnpm*)",
      "Bash(python*)",
      "Bash(python3*)",
      "Bash(pip*)",
      "Bash(pip3*)",
      "Bash(make*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(which*)",
      "Bash(pwd)",
      "Bash(whoami)",
      "Bash(date*)",
      "Bash(env)",
      "Bash(uname*)",
      "Bash(test*)",
      "Bash(true)",
      "Bash(false)"
    ],

    "ask": [
      "Bash(git push*--force*)",
      "Bash(git push*-f *)",
      "Bash(git push* :*)",
      "Bash(git push*:*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -fdx*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r *)",
      "Bash(sudo*)",
      "Bash(chmod -R*)",
      "Bash(mkfs*)",
      "Bash(dd*)"
    ],

    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Read(**/credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(git push*--force*origin main*)",
      "Bash(git push*--force*origin master*)"
    ],

    "defaultMode": "acceptEdits"
  },

  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(git -C /home/user/MD-nahin rev-parse --show-toplevel)}/scripts/install-skills.sh\"",
            "async": true,
            "asyncTimeout": 180000
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "-c",
              "echo '' && echo '══════════════════════════════════════' && echo '  Hunter Studio — Claude Code Active' && echo '  Model: opusplan  |  Effort: xhigh' && echo '  Skills auto-installing in background…' && echo '══════════════════════════════════════' && echo ''"
            ],
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["-c", "echo '[subagent] Task complete'"],
            "async": true
          }
        ]
      }
    ]
  },

  "attribution": {
    "commit": "Co-authored with Claude Code"
  }
}
